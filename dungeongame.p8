pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	start_time = 100
	player = {
		sprite_num = 1,
		x = 64,
		y = 64
	}
end

function _update60()
	key_pressed = stat(30)
	if btn(2) then
		player.y -= 1
		player.sprite_num = 3
	end
	if btn(1) then
		player.x += 1
		player.sprite_num = 4
	end
	if btn(3) then
		player.y += 1
		player.sprite_num = 1
	end
	if btn(0) then
		player.x -= 1
		player.sprite_num = 5
	end

	seconds = time()
	current_time = start_time - flr(seconds)
end

function _draw()
	cls()
	map()
	spr(player.sprite_num, player.x, player.y)
	print(current_time)
end

